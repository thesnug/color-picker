{
  "name": "@thesnug/color-picker",
  "version": "0.1.0",
  "description": "Color palettes from Sanzo Wada's A Dictionary of Color Combinations, with garment color recommendations for print-on-demand designs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesnug/color-picker.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./fingerprint": {
      "types": "./dist/fingerprint/index.d.ts",
      "default": "./dist/fingerprint/index.js"
    },
    "./jev": {
      "types": "./dist/jev/index.d.ts",
      "default": "./dist/jev/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "color-picker": "./dist/cli/main.js",
    "color-picker-mcp": "./dist/mcp/main.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "data:build": "tsx scripts/build-data.ts",
    "data:check": "tsx scripts/build-data.ts --check",
    "products:check": "tsx scripts/validate-products.ts",
    "products:equivalents": "tsx scripts/build-equivalents.ts",
    "products:equivalents:check": "tsx scripts/build-equivalents.ts --check",
    "products:import": "tsx scripts/import-printify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "tsx scripts/release.ts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "sharp": "^0.35.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@typesafe-ai/sdk": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^20.19.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ajv": "^8.20.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
